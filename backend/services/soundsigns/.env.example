# Copy this file to .env and fill in a real key only if you want to try the
# SoundSigns speech-to-ISL translation feature. Without a key, the service
# still starts and GET /health still responds, but POST /translate returns
# a clear error instead of a fake translation.

# This reuses the SAME Requesty API key already used elsewhere in
# SignBridge (see backend/.env.example), so you do not need a second key.
REQUESTY_API_KEY=

# Which model to prefer first. See frontend/lib/config/requestyModels.ts
# for the full priority list this service falls back through.
REQUESTY_MODEL=nvidia/nemotron-3-super-120b-a12b

# Requesty's API base URL.
REQUESTY_BASE_URL=https://router.requesty.ai/v1

# Optional last-resort backup providers, tried in this order (OpenRouter,
# then Groq, then Gemini) only if Requesty's own full model fallback chain
# is exhausted or its key is invalid. Leave any of these blank to skip that
# provider. None of these are required; Requesty alone is enough.
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# The frontend origin(s) allowed to call this service's API from a browser.
# Comma-separated if you ever need more than one. Defaults to the local
# Next.js dev server. Set this to your real deployed frontend origin in
# production, for example:
# ALLOWED_ORIGIN=https://signbridge.pages.dev
ALLOWED_ORIGIN=http://localhost:3000
