# Copy this file to .env and fill in a real key only if you want to try the
# optional Milestone 4 integration. Without a key, the backend works fine and
# just uses local curated suggestions.

# Which model to prefer first. See frontend/lib/config/requestyModels.ts
# for the full priority list this backend falls back through.
REQUESTY_MODEL=nvidia/nemotron-3-super-120b-a12b

# Requesty's API base URL.
REQUESTY_BASE_URL=https://router.requesty.ai/v1

# Your Requesty API key. Leave blank to keep the backend in local-only mode.
REQUESTY_API_KEY=
