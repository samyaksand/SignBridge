# Node / frontend
node_modules/
.next/
out/
build/
dist/
.open-next/
.dev.vars
.wrangler/

# Env files (never commit secrets)
.env
.env.local
.env.*.local
# Note: .env.example files ARE committed intentionally as templates.
# Keep real secrets out of them; do not add .env.example here.

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# ML artifacts (never commit large binaries)
ml/datasets/
ml/checkpoints/
ml/logs/
ml/artifacts/
ml/models/*.task
*.onnx
*.npy
*.npz
*.pt
# Exception: the real, vendored word-recognition model weights, merged
# into backend/app/isl_recognition, are a genuine third-party model file
# this backend needs to run, not a generated ML training artifact.
!backend/app/isl_recognition/model.npz

# OS / editor
.DS_Store
Thumbs.db
.vscode/
*.log

.claude/
